# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bsos?schema=public

# Used by npm test. Must NOT be the dev database: tests wipe every table in it.
# A separate schema of the same database is fine.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bsos?schema=test

# Redis
REDIS_URL=redis://localhost:6379

# JWT — at least 32 chars each, different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Allowed browser origin for CORS + Socket.io
CLIENT_ORIGIN=http://localhost:5173

# Third-party services (later tiers)
CLOUDINARY_URL=
SMS_PROVIDER_KEY=
FCM_SERVER_KEY=
